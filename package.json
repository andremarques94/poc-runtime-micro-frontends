{
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.4",
		"turbo": "^2.9.14",
		"typescript": "5.9.2",
		"ultracite": "7.7.0"
	},
	"name": "ds-remote",
	"scripts": {
		"biome": "biome check .",
		"biome:fix": "biome check . --write",
		"build": "turbo run build",
		"check": "ultracite check",
		"check-types": "turbo run check-types",
		"dev": "turbo run dev",
		"fix": "ultracite fix",
		"format": "pnpm fix",
		"lint": "turbo run //#biome",
		"lint:fix": "turbo run //#biome:fix",
		"postinstall": "pnpm rebuild better-sqlite3",
		"prepare": "husky"
	},
	"private": true,
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=18"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3"
		]
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
			"pnpm fix"
		]
	}
}
